config_version=5
[application]
config/name="Ultimate Animation Library — Free Demo / 20 Animations"
run/main_scene="res://showcase.tscn"
[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05,0.075,0.09,1)
[editor]
movie_writer/fps=60
movie_writer/video_quality=0.9
movie_writer/disable_vsync=true
