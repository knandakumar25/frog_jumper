; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Axiom Force: Reclaim Earth"
run/main_scene="res://assets/scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

Global="*res://assets/scenes/global.gd"
SessionManager="*res://assets/scenes/SessionManager.cs"
NarrativeManager="*res://assets/narrative/NarrativeManager.gd"
AuthManager="*res://assets/scenes/AuthManager.cs"
UISoundManager="*res://assets/scenes/UISoundManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://assets/images/cursor.png"
mouse_cursor/tooltip_position_offset=Vector2(1, 1)

[dotnet]

project/assembly_name="FrogJumper"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg", "res://addons/meshy-godot-plugin/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom_font="res://assets/fonts/NotoSans-Regular.ttf"

