# This backend-specific allowlist keeps the root build context small without
# changing what the exporter or other Dockerfiles can access.
**
!requirements.txt
!backend/
!backend/**

# Source only: never include credentials, virtualenvs, databases or runtime caches.
backend/.env
backend/.env.*
backend/**/.env
backend/**/.env.*
backend/.venv/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/*.sqlite3
