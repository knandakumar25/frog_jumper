# Copy to '.env' (gitignored) and fill in. Nothing in the repository parses
# this file automatically: export the variables in your shell (or hand them to
# your process manager / container runtime) before starting the backend.

# PostgreSQL Configuration
# POSTGRES_* configure the database server itself; DB_* are what the accounts
# API (backend/, Express.js) connects with.
POSTGRES_DB=accounts_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=accounts_db
DB_USER=postgres
DB_PASSWORD=postgres

# Accounts API (backend/, Express.js)
# Signs the API's access and refresh tokens (HS256). Required: the API refuses
# to start without it. Use a long random value and keep it out of git, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SIGNING_KEY=
# The website origin used in emailed and browser sign-in links.
FRONTEND_URL=http://localhost:5173
# Optional: PBKDF2 rounds for new password hashes (default 1200000, as Django 6).
# PASSWORD_ITERATIONS=1200000
# Optional limits (defaults shown). Per IP per minute on login, register,
# 2fa/verify-login and token/refresh; per username per 15 minutes on login; emailed
# codes per user and purpose per 15 minutes; browser sign-in requests per IP per minute;
# password hashes running at once.
# AUTH_PER_IP_PER_MINUTE=10
# LOGIN_PER_USER_PER_15_MIN=10
# CODES_PER_USER_PER_15_MIN=5
# BROWSER_THROTTLE_PER_MINUTE=90
# MAX_CONCURRENT_HASHES=4
# Only this host's X-Forwarded-For is trusted (the nginx `website` service).
# TRUSTED_PROXY_HOST=website
# The old third-party sign-in routes and their keys were removed with Django on
# 2026-11-15; nothing reads their variables or SECRET_KEY.

# Transactional Email (Resend)
# Leave RESEND_API_KEY empty to fall back to the console backend: mail is
# printed to the container log instead of being sent, and no secret is needed.
# Set it to an re_... key from https://resend.com/api-keys (Sending access).
RESEND_API_KEY=
# Must sit on a domain verified in Resend, or the API returns 403. The default
# is Resend's shared test sender, which needs no domain but can only deliver to
# the address on the Resend account itself.
DEFAULT_FROM_EMAIL=Axiom Force <onboarding@resend.dev>
# Seconds before an outbound Resend request is abandoned.
RESEND_TIMEOUT=10

# Clerk (identity provider)
# BACKEND secret: authenticates the API's server-side calls to Clerk, used
# to turn a Clerk user id into a verified email address during onboarding.
# It must NEVER be given a VITE_ prefix -- Vite inlines every VITE_* value into
# the browser bundle, which would publish it.
#
# Leave it empty to disable onboarding: POST /api/auth/onboarding/start/ then
# answers 503 instead of sending anything. Nothing else in the stack needs it.
#
# OPERATIONAL DEPENDENCY: onboarding refuses to mail an unverified address, so
# email verification must stay ENABLED in the Clerk dashboard. With it off,
# every signup answers 403 email_not_verified.
CLERK_SECRET_KEY=
# Exact trusted Clerk issuer and allowed website origins for browser game approval.
CLERK_ISSUER=
# Optional override; defaults to CLERK_ISSUER + /.well-known/jwks.json.
# CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Game process environment only; defaults to http://localhost:8000/api.
# AXIOM_API_BASE_URL=http://localhost:8000/api
# Seconds before an outbound Clerk request is abandoned.
CLERK_TIMEOUT=10

# Onboarding (email-gated signup) -- optional, defaults shown.
# How long an emailed onboarding link stays usable.
# ONBOARDING_TOKEN_TTL_HOURS=24
# Minimum gap between sends for one registration; inside it /start/ answers
# "already_sent" instead of mailing again.
# ONBOARDING_RESEND_COOLDOWN=60
# Lifetime send cap per registration; every send rotates the token and kills
# the previous link.
# ONBOARDING_MAX_SENDS=5
# Per-IP and global ceilings over any rolling hour. The global one is the
# billing circuit breaker.
# ONBOARDING_IP_HOURLY_LIMIT=5
# ONBOARDING_GLOBAL_HOURLY_LIMIT=100

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
