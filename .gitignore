# Created by https://www.toptal.com/developers/gitignore/api/godot
# Edit at https://www.toptal.com/developers/gitignore?templates=godot

### Godot ###
# Godot 4+ specific ignores
.godot/
.idea/
.vscode/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# C# build / NuGet
nuget.config
# Temp DLLs (prefixed with ~)
addons/**/~*.dll
*.TMP
~*.TMP

# End of https://www.toptal.com/developers/gitignore/api/godot

.fake

# Android build artifacts
android/build/.gradle/
android/build/local.properties
android/build/build/reports/

# Scratch / temp directories
scratch/
website/scratch/

# Graphify output
graphify-out/

# Codex output
.codex/

# Local migration records and validation tools
.validation/

# Built Android binaries
build/

# Test screenshots
assets/images/screenshot_*.png*

# Python & Virtualenv
__pycache__/
*.py[cod]
.venv/
backend/.venv/
# Express.js accounts API packages (installed by npm ci in the image).
backend/node_modules/

# .NET / C# build outputs
[Bb]in/
[Oo]bj/

# GdUnit4 Test Reports
reports/

# Logs
*.log
!assets/narrative/translate_progress.log

# Local environment / secrets
# NOTE: negation must come last, or .env.* swallows .env.example
.env
.env.*
!.env.example

.skill-install-staging/

backups/
